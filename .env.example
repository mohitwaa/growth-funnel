# Copy to `.env.local`. Vite compiles VITE_* into the public bundle, so nothing
# secret belongs here — the Meta CAPI token and Airtable PAT live in n8n
# credentials, never in the client.

# Where every event is POSTed. The n8n Webhook node.
# Its "Allowed Origins (CORS)" must be set, or the browser cannot read the
# response status and the outbox will retry events that already landed.
VITE_WEBHOOK_URL=

# Meta Pixel / dataset ID. Public by design — it ships in the browser.
VITE_META_PIXEL_ID=

# Independent sink for events the outbox gave up on after 6 attempts.
# MUST be a different host from VITE_WEBHOOK_URL: reporting a failure to the
# endpoint that just failed is how permanent losses become invisible.
# Left empty, losses are written to localStorage under `__lost` instead.
VITE_DEAD_LETTER_URL=

# The on-screen event log is enabled per-session with ?debug=1 on any URL,
# so it needs no build-time flag.
