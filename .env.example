# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. Vite only exposes VITE_* to the browser.
# NEVER put a Meta access token or any secret in a VITE_* variable — anything
# with that prefix is compiled into the public bundle.
# ---------------------------------------------------------------------------

# The webhook that receives every event. Provide this when ready.
# Until it is set, the webhook destination logs intent and no-ops safely.
VITE_WEBHOOK_URL=

# Optional shared secret sent as `X-Funnel-Signature` so your endpoint can
# reject forged traffic. This IS visible in the bundle — treat it as a weak
# filter, not authentication. Real auth belongs behind your own /api proxy.
VITE_WEBHOOK_KEY=

# Meta Pixel ID (public by design — it ships in the browser).
VITE_META_PIXEL_ID=

# GA4 Measurement ID (optional).
VITE_GA4_MEASUREMENT_ID=

# Show the on-screen event inspector. Also enabled by ?debug=1 on any URL.
VITE_DEBUG_TRACKING=false


# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY (no VITE_ prefix — never reaches the browser)
# Used by api/lead.ts for the Conversions API relay.
# ---------------------------------------------------------------------------
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
LEAD_WEBHOOK_URL=
